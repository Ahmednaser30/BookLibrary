# Copy to .env and change the values. .env is git-ignored.
# Read by docker compose and by the Spring Boot app (spring.config.import).

DB_NAME=book_library
DB_USERNAME=bookshop
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Base64-encoded HMAC-SHA256 key, at least 32 bytes. Generate one with:
#   openssl rand -base64 32
# Leave empty to get a random key per start (tokens then expire on restart).
JWT_SECRET=

MAIL_FROM=no-reply@booklibrary.local
